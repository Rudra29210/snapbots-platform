# Client-side Firebase config. These values are PUBLIC identifiers, not secrets.
# Access is enforced by Firestore/Storage rules and App Check, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" only when the emulators are running locally (npm run emulators).
VITE_USE_EMULATORS=false
# Optional reCAPTCHA v3 site key for Firebase App Check (web). Leave empty to skip App Check.
VITE_APP_CHECK_SITE_KEY=
# Public contact address shown on the site.
VITE_CONTACT_EMAIL=mishrarudra641@gmail.com
