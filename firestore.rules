rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validSubmission() {
      return request.resource.data.status == 'new'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.userId == null
          || (
            signedIn()
            && request.resource.data.userId == request.auth.uid
          )
        );
    }

    function ownsRecord() {
      return signedIn()
        && resource.data.userId == request.auth.uid;
    }

    function validAdminRecordUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'internalNote',
            'updatedAt',
            'updatedBy'
          ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function publishedProject(projectId) {
      return exists(
        /databases/$(database)/documents/projects/$(projectId)
      )
      && get(
        /databases/$(database)/documents/projects/$(projectId)
      ).data.status == 'published';
    }

    match /enquiries/{id} {
      allow create: if validSubmission();
      allow read: if isAdmin() || ownsRecord();
      allow update: if validAdminRecordUpdate();
      allow delete: if isAdmin();
    }

    match /partnerships/{id} {
      allow create: if validSubmission();
      allow read: if isAdmin() || ownsRecord();
      allow update: if validAdminRecordUpdate();
      allow delete: if isAdmin();
    }

    match /supportTickets/{id} {
      allow create: if validSubmission();
      allow read: if isAdmin() || ownsRecord();
      allow update: if validAdminRecordUpdate();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin()
        || resource.data.status == 'published';

      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.sku is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.status in [
          'draft', 'published', 'archived'
        ];

      allow update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.sku is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.status in [
          'draft', 'published', 'archived'
        ];

      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAdmin()
        || resource.data.status == 'published'
        || (
          signedIn()
          && resource.data.authorId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.status == 'pending_review'
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.status in [
            'draft',
            'pending_review',
            'changes_requested'
          ]
          && request.resource.data.status != 'published'
        );

      allow delete: if isAdmin();

      match /likes/{userId} {
        // Required for Firestore getCountFromServer().
        // Like documents contain no email or display name.
        allow read: if publishedProject(projectId);

        allow create: if signedIn()
          && publishedProject(projectId)
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userId',
            'createdAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow delete: if signedIn()
          && userId == request.auth.uid
          && publishedProject(projectId);

        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isAdmin()
          || (
            publishedProject(projectId)
            && resource.data.status == 'visible'
          );

        allow create: if signedIn()
          && publishedProject(projectId)
          && request.resource.data.keys().hasOnly([
            'authorId',
            'authorName',
            'text',
            'parentId',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.status == 'visible'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            request.resource.data.parentId == null
            || (
              request.resource.data.parentId is string
              && exists(
                /databases/$(database)/documents/projects/$(projectId)/comments/$(request.resource.data.parentId)
              )
              && get(
                /databases/$(database)/documents/projects/$(projectId)/comments/$(request.resource.data.parentId)
              ).data.status == 'visible'
            )
          );

        // Admins can hide or restore comments.
        // Authors cannot edit their own comments in this version.
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'moderatedAt', 'moderatedBy'])
          && request.resource.data.status in ['visible', 'hidden']
          && request.resource.data.moderatedBy == request.auth.uid
          && request.resource.data.moderatedAt == request.time;

        allow delete: if isAdmin();
      }
    }

    match /projectSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending_review';

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.authorId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /communityReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'targetType',
          'projectId',
          'targetId',
          'reason',
          'status',
          'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['project', 'comment']
        && request.resource.data.projectId is string
        && request.resource.data.targetId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && publishedProject(request.resource.data.projectId);

      allow read: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'moderatorNote', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in [
          'open', 'reviewed', 'dismissed', 'action_taken'
        ]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow delete: if isAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}